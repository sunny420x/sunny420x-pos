<%
const startPage = Math.max(1, Math.min(pagination.page - 2, pagination.totalPages - 4));
const endPage = Math.min(pagination.totalPages, startPage + 4);
const startItem = pagination.total ? pagination.offset + 1 : 0;
const endItem = Math.min(pagination.offset + pagination.pageSize, pagination.total);
%>
<div class="mt-3">
    <% if (pagination.totalPages > 1) { %>
    <nav aria-label="เปลี่ยนหน้ารายการ">
        <ul class="pagination justify-content-center">
            <li class="page-item <%=pagination.page === 1 ? 'disabled' : ''%>">
                <% if (pagination.ajax) { %>
                <a class="page-link text-black" href="#" data-page="<%=pagination.page - 1%>" aria-label="ย้อนกลับ" <%=pagination.page === 1 ? 'aria-disabled="true" tabindex="-1"' : ''%>>ย้อนกลับ</a>
                <% } else { %>
                <a class="page-link text-black" href="<%=pagination.href(Math.max(pagination.page - 1, 1))%>" aria-label="ย้อนกลับ" <%=pagination.page === 1 ? 'aria-disabled="true" tabindex="-1"' : ''%>>ย้อนกลับ</a>
                <% } %>
            </li>
            <% for (let page = startPage; page <= endPage; page++) { %>
            <li class="page-item <%=pagination.page === page ? 'active' : ''%>">
                <% if (pagination.ajax) { %>
                <a class="page-link text-black <%=pagination.page === page ? 'active text-white' : ''%>" href="#" data-page="<%=page%>" aria-label="หน้า <%=page%>" <%=pagination.page === page ? 'aria-current="page"' : ''%>><%=page%></a>
                <% } else { %>
                <a class="page-link text-black <%=pagination.page === page ? 'active text-white' : ''%>" href="<%=pagination.href(page)%>" aria-label="หน้า <%=page%>" <%=pagination.page === page ? 'aria-current="page"' : ''%>><%=page%></a>
                <% } %>
            </li>
            <% } %>
            <li class="page-item <%=pagination.page === pagination.totalPages ? 'disabled' : ''%>">
                <% if (pagination.ajax) { %>
                <a class="page-link text-black" href="#" data-page="<%=pagination.page + 1%>" aria-label="หน้าต่อไป" <%=pagination.page === pagination.totalPages ? 'aria-disabled="true" tabindex="-1"' : ''%>>หน้าต่อไป</a>
                <% } else { %>
                <a class="page-link text-black" href="<%=pagination.href(Math.min(pagination.page + 1, pagination.totalPages))%>" aria-label="หน้าต่อไป" <%=pagination.page === pagination.totalPages ? 'aria-disabled="true" tabindex="-1"' : ''%>>หน้าต่อไป</a>
                <% } %>
            </li>
        </ul>
    </nav>
    <% } %>
    <p class="text-muted text-center mb-0">แสดง <%=startItem%> ถึง <%=endItem%> จากทั้งหมด <%=pagination.total%> รายการ</p>
</div>