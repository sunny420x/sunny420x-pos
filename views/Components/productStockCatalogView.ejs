<div class="row row-cols-lg-4 row-cols-md-3 row-cols-1 g-0 product-grid">
    <% products_stock.forEach((row) => { %>
        <div class="col px-2"><div class="product-tile">
            <h5><%=row.name%> (<%=row.type%>)</h5>
            <% if (stock_mode !== 'inventory_only') { %>
            <p class="mb-1">ราคา: <%=row.price%></p>
            <% } %>
            <p class="mb-2">คงเหลือ: <%if(row.value != 0) {%><%=row.value%><%} else {%><span class="badge bg-danger">สินค้าหมด</span><%}%></p>
            <% if (stock_mode === 'inventory_only') { %>
            <button class="btn btn-warning" data-type="<%=row.type_id%>" data-name="<%=row.name%>" onclick="deductStockFromButton(this)" aria-label="ตัดสต๊อก <%=row.name%>" title="ตัดสต๊อกสินค้า" <%=row.value <= 0 ? 'disabled' : ''%>><i class="fa-solid fa-minus"></i></button>
            <% } else { %>
            <button class="btn btn-warning" onclick="addToCart('<%=row.type_id%>', '<%=row.name%>', '<%=row.price%>', 1, '<%=row.value%>')" <%=row.value <= 0 ? 'disabled' : ''%>><i class="fa-solid fa-shopping-cart"></i></button>
            <% } %>
            <button class="btn btn-primary" onclick="openLink('/products_stock/<%=row.type_id%>/<%=encodeURIComponent(row.name)%>?option=catalog&type=<%=type%>')"><i class="fa-solid fa-up-right-from-square"></i></button>
        </div></div>
    <%})%>
</div>
<%-include('pagination', { pagination: pagination })%>
