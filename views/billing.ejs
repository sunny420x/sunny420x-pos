<html>
    <head>
        <%-include('include/head')%>
    </head>
    <body class="<%= receipt_size === '80x80' ? 'thermal-receipt-page' : 'a5-receipt-page' %>">
        <%
        helper = new Helper()
        sum = 0
        discount = bill[0].discount_amount || 0
        %>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
        <% if (receipt_size === '80x80') { %>
        <style>
            .thermal-receipt-page {
                background: #fff;
                color: #111;
            }
            .receipt-thermal {
                width: 80mm;
                min-height: 80mm;
                box-sizing: border-box;
                margin: 0 auto;
                padding: 3mm;
                background: #fff;
                color: #111;
                font-family: 'Prompt', sans-serif;
                font-size: 7pt;
                line-height: 1.25;
            }
            .receipt-thermal h1,
            .receipt-thermal p {
                margin: 0;
            }
            .receipt-thermal .receipt-heading {
                padding-bottom: 2mm;
                border-bottom: 1px dashed #555;
                text-align: center;
            }
            .receipt-thermal .receipt-company {
                font-size: 10pt;
                font-weight: 600;
                overflow-wrap: anywhere;
            }
            .receipt-thermal .receipt-title {
                margin-top: 1mm;
                font-size: 8pt;
                font-weight: 500;
            }
            .receipt-thermal .receipt-meta {
                display: flex;
                justify-content: space-between;
                gap: 2mm;
                padding: 1.5mm 0;
                border-bottom: 1px dashed #999;
            }
            .receipt-thermal .receipt-customer {
                padding: 1.5mm 0;
                border-bottom: 1px dashed #999;
                overflow-wrap: anywhere;
            }
            .receipt-thermal table {
                width: 100%;
                margin: 1mm 0;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 7pt !important;
            }
            .receipt-thermal th,
            .receipt-thermal td {
                padding: 1mm 0 !important;
                border-bottom: 1px dashed #ccc;
                vertical-align: top;
                overflow-wrap: anywhere;
            }
            .receipt-thermal th {
                font-weight: 500;
            }
            .receipt-thermal .receipt-item-price {
                display: block;
                color: #555;
                font-size: 6pt;
            }
            .receipt-thermal .receipt-totals {
                padding-top: 1mm;
                border-top: 1px dashed #555;
            }
            .receipt-thermal .receipt-total-line {
                display: flex;
                justify-content: space-between;
                gap: 2mm;
                padding: .5mm 0;
            }
            .receipt-thermal .receipt-net {
                margin-top: 1mm;
                padding-top: 1mm;
                border-top: 1px solid #111;
                font-size: 9pt;
                font-weight: 600;
            }
            .receipt-thermal .receipt-thanks {
                margin-top: 2mm;
                padding-top: 1mm;
                border-top: 1px dashed #999;
                text-align: center;
            }
            .receipt-actions {
                width: 80mm;
                margin: 8px auto;
                display: flex;
                justify-content: center;
                gap: 8px;
            }
            @page {
                size: 80mm 80mm;
                margin: 0;
            }
            @media print {
                html,
                body.thermal-receipt-page {
                    width: 80mm;
                    min-height: 80mm;
                    margin: 0 !important;
                    padding: 0 !important;
                    background: #fff !important;
                }
                .receipt-toolbar,
                .receipt-actions {
                    display: none !important;
                }
                .receipt-thermal {
                    margin: 0 !important;
                }
            }
        </style>
        <nav class="navbar navbar-light bg-white receipt-toolbar">
            <div class="navbar-brand"><a href="/billingHistories" class="px-4 py-2 text-decoration-none text-black">
                <i class="fa-solid fa-chevron-left me-2"></i> ย้อนกลับ</a></div>
        </nav>
        <%
            sum = bill.reduce((total, row) => total + parseInt(row.total_price || 0, 10), 0)
        %>
        <main class="receipt-thermal" id="billing_content">
            <header class="receipt-heading">
                <h1 class="receipt-company"><%=user_data[0].company_name%></h1>
                <p class="receipt-title">ใบเสร็จรับเงิน</p>
            </header>
            <section class="receipt-meta">
                <span>เลขที่ #<%=billing_id%></span>
                <span><%=moment(bill[0].created_at).add(543, 'years').format('DD/MM/YYYY HH:mm')%></span>
            </section>
            <section class="receipt-customer">
                <p>ลูกค้า: <%if(bill[0].first_name != null && bill[0].last_name != null) {%><%=bill[0].first_name%> <%=bill[0].last_name%><%} else {%>-<%}%></p>
                <%if(bill[0].phone_number) {%><p>โทร: <%=helper.ThaiPhoneNumber(bill[0].phone_number)%></p><%}%>
            </section>
            <table>
                <colgroup>
                    <col style="width: 54%">
                    <col style="width: 14%">
                    <col style="width: 32%">
                </colgroup>
                <thead>
                    <tr>
                        <th>รายการ</th>
                        <th class="text-end">จำนวน</th>
                        <th class="text-end">รวม</th>
                    </tr>
                </thead>
                <tbody>
                    <%bill.forEach(row => {%>
                    <tr>
                        <td><%=row.name%><span class="receipt-item-price"><%=helper.numberWithCommas(row.price)%> บาท/ชิ้น</span></td>
                        <td class="text-end"><%=row.amount%></td>
                        <td class="text-end"><%=helper.numberWithCommas(row.total_price)%></td>
                    </tr>
                    <%})%>
                </tbody>
            </table>
            <section class="receipt-totals">
                <div class="receipt-total-line"><span>รวม</span><span><%=helper.numberWithCommas(sum)%> บาท</span></div>
                <%if(discount != 0) {%>
                <div class="receipt-total-line"><span>ส่วนลด (<%=discount%>%)</span><span>-<%=helper.numberWithCommas((sum * discount) / 100)%> บาท</span></div>
                <%}%>
                <div class="receipt-total-line receipt-net">
                    <span>ชำระสุทธิ</span>
                    <span><%=helper.numberWithCommas(discount == 0 ? sum : sum - (sum * discount) / 100)%> บาท</span>
                </div>
            </section>
            <p class="receipt-thanks">ขอบคุณที่ใช้บริการ</p>
        </main>
        <div class="receipt-actions">
            <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> พิมพ์ใบเสร็จ</button>
            <button class="btn btn-secondary" onclick="exportToPDF()">ส่งออก PDF 80 × 80 มม.</button>
        </div>
        <% } else { %>
        <style>
            .a5-receipt-page {
                min-height: 100vh;
                background: #eef0f3;
                color: #20252d;
            }
            .a5-receipt-toolbar {
                max-width: 1120px;
                margin: 0 auto;
                padding: 12px 20px;
            }
            .a5-receipt-toolbar .navbar-brand {
                margin: 0;
            }
            .a5-receipt-toolbar a {
                color: #525b67 !important;
                text-decoration: none;
            }
            .a5-receipt-sheet {
                box-sizing: border-box;
                width: 210mm;
                min-height: 148mm;
                margin: 24px auto;
                padding: 13mm 15mm 11mm;
                background: #fff;
                color: #20252d;
                box-shadow: 0 10px 36px #1822301c;
                font-family: 'Prompt', sans-serif;
                font-size: 10pt;
                line-height: 1.5;
            }
            .a5-receipt-sheet * {
                box-sizing: border-box;
            }
            .a5-receipt-sheet p,
            .a5-receipt-sheet h1,
            .a5-receipt-sheet h2 {
                margin: 0;
            }
            .a5-receipt-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 16px;
                padding-bottom: 7mm;
                border-bottom: 2px solid #20252d;
            }
            .a5-receipt-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 0;
            }
            .a5-receipt-mark {
                display: grid;
                width: 44px;
                height: 44px;
                flex: 0 0 44px;
                place-items: center;
                border-radius: 12px;
                background: #20252d;
                color: #fff;
                font-size: 17pt;
                font-weight: 600;
            }
            .a5-receipt-company {
                overflow-wrap: anywhere;
                font-size: 17pt;
                font-weight: 600;
                line-height: 1.25;
            }
            .a5-receipt-subtitle {
                margin-top: 3px !important;
                color: #707987;
                font-size: 8.5pt;
            }
            .a5-receipt-title {
                flex: 0 0 auto;
                text-align: right;
            }
            .a5-receipt-title h2 {
                font-size: 19pt;
                font-weight: 600;
                line-height: 1.2;
            }
            .a5-receipt-title p {
                margin-top: 5px;
                color: #707987;
                font-size: 9pt;
            }
            .a5-receipt-info {
                display: grid;
                grid-template-columns: 1.25fr 1fr;
                gap: 7mm;
                padding: 6mm 0;
                border-bottom: 1px solid #dfe3e8;
            }
            .a5-receipt-info-label {
                margin-bottom: 2mm !important;
                color: #7a8491;
                font-size: 8pt;
            }
            .a5-receipt-info-value {
                font-size: 10pt;
                font-weight: 500;
            }
            .a5-receipt-meta {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 4mm 8mm;
                align-content: start;
            }
            .a5-receipt-meta .a5-receipt-info-label {
                margin-bottom: 1mm !important;
            }
            .a5-receipt-meta .a5-receipt-info-value {
                font-size: 9pt;
                font-variant-numeric: tabular-nums;
            }
            .a5-receipt-table {
                width: 100%;
                margin: 6mm 0 5mm;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 9pt;
            }
            .a5-receipt-table th {
                padding: 3mm 2mm;
                border-bottom: 1px solid #20252d;
                color: #626c78;
                font-size: 8pt;
                font-weight: 500;
                text-align: left;
            }
            .a5-receipt-table td {
                padding: 3mm 2mm;
                border-bottom: 1px solid #edf0f3;
                vertical-align: top;
            }
            .a5-receipt-table .a5-receipt-item {
                overflow-wrap: anywhere;
                font-weight: 500;
            }
            .a5-receipt-table .a5-receipt-item-price {
                display: block;
                margin-top: 1px;
                color: #7a8491;
                font-size: 8pt;
                font-weight: 400;
            }
            .a5-receipt-number {
                text-align: right !important;
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
            }
            .a5-receipt-bottom {
                display: grid;
                grid-template-columns: 1fr minmax(220px, .72fr);
                gap: 10mm;
                align-items: end;
                padding-top: 2mm;
            }
            .a5-receipt-thanks {
                align-self: end;
                padding-bottom: 2mm;
                color: #626c78;
                font-size: 9pt;
            }
            .a5-receipt-totals {
                padding: 4mm 5mm;
                border: 1px solid #dfe3e8;
                border-radius: 10px;
            }
            .a5-receipt-total-line {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                padding: 1.5mm 0;
                color: #626c78;
                font-size: 9pt;
            }
            .a5-receipt-net {
                margin-top: 2mm;
                padding-top: 3mm;
                border-top: 1px solid #dfe3e8;
                color: #20252d;
                font-size: 11pt;
                font-weight: 600;
            }
            .a5-receipt-footer {
                display: flex;
                justify-content: space-between;
                gap: 12px;
                margin-top: 7mm;
                padding-top: 3mm;
                border-top: 1px solid #edf0f3;
                color: #8a929d;
                font-size: 7.5pt;
            }
            .a5-receipt-actions {
                display: flex;
                justify-content: center;
                gap: 10px;
                max-width: 1120px;
                margin: 0 auto 24px;
            }
            @media (max-width: 767.98px) {
                .a5-receipt-sheet {
                    width: calc(100% - 24px);
                    min-height: 0;
                    margin: 12px auto;
                    padding: 24px 20px;
                }
                .a5-receipt-header {
                    gap: 12px;
                }
                .a5-receipt-company {
                    font-size: 13pt;
                }
                .a5-receipt-title h2 {
                    font-size: 15pt;
                }
                .a5-receipt-info {
                    grid-template-columns: 1fr;
                    gap: 5mm;
                }
                .a5-receipt-bottom {
                    grid-template-columns: 1fr;
                    gap: 5mm;
                }
            }
            @page {
                size: A5 landscape;
                margin: 0;
            }
            @media print {
                html,
                body.a5-receipt-page {
                    width: 210mm;
                    min-height: 148mm;
                    margin: 0 !important;
                    padding: 0 !important;
                    background: #fff !important;
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                .a5-receipt-toolbar,
                .a5-receipt-actions {
                    display: none !important;
                }
                .a5-receipt-sheet {
                    width: 210mm;
                    min-height: 148mm;
                    margin: 0;
                    padding: 12mm 14mm 10mm;
                    box-shadow: none;
                }
                .a5-receipt-table tr,
                .a5-receipt-totals,
                .a5-receipt-info {
                    break-inside: avoid;
                }
            }
        </style>
        <%
            const a5Subtotal = bill.reduce((total, row) => total + Number(row.total_price || 0), 0);
            const a5DiscountAmount = a5Subtotal * Number(discount) / 100;
            const a5Total = a5Subtotal - a5DiscountAmount;
            const a5CustomerName = bill[0].first_name && bill[0].last_name
                ? `${bill[0].first_name} ${bill[0].last_name}`
                : 'ลูกค้าทั่วไป';
        %>
        <nav class="navbar a5-receipt-toolbar">
            <div class="navbar-brand"><a href="/billingHistories">
                <i class="fa-solid fa-chevron-left me-2"></i> กลับไปประวัติการขาย</a></div>
        </nav>
        <main class="a5-receipt-sheet" id="billing_content">
            <header class="a5-receipt-header">
                <div class="a5-receipt-brand">
                    <span class="a5-receipt-mark" aria-hidden="true"><i class="fa-solid fa-receipt"></i></span>
                    <div>
                        <h1 class="a5-receipt-company"><%=user_data[0].company_name%></h1>
                        <p class="a5-receipt-subtitle">เอกสารรับชำระเงิน</p>
                    </div>
                </div>
                <div class="a5-receipt-title">
                    <h2>ใบเสร็จรับเงิน</h2>
                    <p>ต้นฉบับสำหรับลูกค้า</p>
                </div>
            </header>
            <section class="a5-receipt-info" aria-label="ข้อมูลใบเสร็จและลูกค้า">
                <div>
                    <p class="a5-receipt-info-label">เรียกเก็บจาก</p>
                    <p class="a5-receipt-info-value"><%=a5CustomerName%></p>
                    <% if (bill[0].phone_number) { %>
                    <p class="a5-receipt-subtitle">โทร. <%=helper.ThaiPhoneNumber(bill[0].phone_number)%></p>
                    <% } %>
                </div>
                <div class="a5-receipt-meta">
                    <div>
                        <p class="a5-receipt-info-label">เลขที่ใบเสร็จ</p>
                        <p class="a5-receipt-info-value">#<%=billing_id%></p>
                    </div>
                    <div>
                        <p class="a5-receipt-info-label">วันที่ออกเอกสาร</p>
                        <p class="a5-receipt-info-value"><%=moment(bill[0].created_at).add(543, 'years').format('DD/MM/YYYY')%></p>
                    </div>
                    <div>
                        <p class="a5-receipt-info-label">เวลา</p>
                        <p class="a5-receipt-info-value"><%=moment(bill[0].created_at).format('HH:mm')%></p>
                    </div>
                    <div>
                        <p class="a5-receipt-info-label">สถานะ</p>
                        <p class="a5-receipt-info-value">ชำระแล้ว</p>
                    </div>
                </div>
            </section>
            <table class="a5-receipt-table">
                <colgroup>
                    <col style="width: 52%">
                    <col style="width: 16%">
                    <col style="width: 16%">
                    <col style="width: 16%">
                </colgroup>
                <thead>
                    <tr>
                        <th>รายการสินค้า</th>
                        <th class="a5-receipt-number">จำนวน</th>
                        <th class="a5-receipt-number">ราคาต่อหน่วย</th>
                        <th class="a5-receipt-number">จำนวนเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    <% bill.forEach(row => { %>
                    <tr>
                        <td class="a5-receipt-item"><%=row.name%></td>
                        <td class="a5-receipt-number"><%=helper.numberWithCommas(row.amount)%></td>
                        <td class="a5-receipt-number"><%=helper.numberWithCommas(row.price)%></td>
                        <td class="a5-receipt-number"><%=helper.numberWithCommas(row.total_price)%></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <section class="a5-receipt-bottom">
                <p class="a5-receipt-thanks"><i class="fa-solid fa-heart me-1"></i> ขอบคุณที่อุดหนุนและไว้วางใจใช้บริการ</p>
                <div class="a5-receipt-totals">
                    <div class="a5-receipt-total-line">
                        <span>รวมสินค้า</span>
                        <span><%=helper.numberWithCommas(a5Subtotal)%> บาท</span>
                    </div>
                    <% if (Number(discount) !== 0) { %>
                    <div class="a5-receipt-total-line">
                        <span>ส่วนลด (<%=discount%>%)</span>
                        <span>-<%=helper.numberWithCommas(a5DiscountAmount)%> บาท</span>
                    </div>
                    <% } %>
                    <div class="a5-receipt-total-line a5-receipt-net">
                        <span>ยอดชำระสุทธิ</span>
                        <span><%=helper.numberWithCommas(a5Total)%> บาท</span>
                    </div>
                </div>
            </section>
            <footer class="a5-receipt-footer">
                <span>เอกสารนี้ออกโดยระบบ SunnyPOS</span>
                <span>เลขที่ใบเสร็จ #<%=billing_id%></span>
            </footer>
        </main>
        <div class="a5-receipt-actions">
            <button class="btn btn-outline-secondary" onclick="window.location='/billingHistories'"><i class="fa-solid fa-arrow-left me-1"></i> กลับ</button>
            <button class="btn btn-secondary" onclick="exportToPDF()"><i class="fa-solid fa-file-pdf me-1"></i> บันทึก PDF</button>
            <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> พิมพ์ใบเสร็จ</button>
        </div>
        <% } %>
        <script>
            async function exportToPDF() {
              try {
                const { jsPDF } = window.jspdf;
                const isThermalReceipt = <%-JSON.stringify(receipt_size === '80x80')%>;
                const pdf = isThermalReceipt
                  ? new jsPDF('p', 'mm', [80, 80])
                  : new jsPDF('l', 'mm', 'a5');

                const content = document.getElementById('billing_content');
                const canvas = await html2canvas(content, {
                  backgroundColor: '#ffffff',
                  scale: 2,
                  useCORS: true,
                  windowWidth: Math.max(document.documentElement.clientWidth, 1100),
                  onclone: clonedDocument => {
                    clonedDocument.documentElement.style.backgroundColor = '#ffffff';
                    clonedDocument.body.style.backgroundColor = '#ffffff';
                    const receipt = clonedDocument.getElementById('billing_content');
                    if (!receipt || isThermalReceipt) return;
                    receipt.style.width = '210mm';
                    receipt.style.minHeight = '148mm';
                    receipt.style.margin = '0';
                    receipt.style.boxShadow = 'none';
                    receipt.style.backgroundColor = '#ffffff';
                  }
                });
                const imgData = canvas.toDataURL('image/png');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const imgWidth = canvas.width;
                const imgHeight = canvas.height;
                const ratio = Math.min(pageWidth / imgWidth, pageHeight / imgHeight);

                const renderedWidth = imgWidth * ratio;
                const renderedHeight = imgHeight * ratio;
                const x = (pageWidth - renderedWidth) / 2;
                const y = isThermalReceipt ? 0 : (pageHeight - renderedHeight) / 2;
                pdf.addImage(imgData, 'PNG', x, y, renderedWidth, renderedHeight);
                pdf.save(isThermalReceipt ? 'ใบเสร็จรับเงิน-80x80.pdf' : 'ใบเสร็จรับเงิน.pdf');
              } catch (error) {
                console.error('Receipt PDF export failed:', error);
                if (window.Swal) {
                  Swal.fire({
                    icon: 'error',
                    title: 'บันทึก PDF ไม่สำเร็จ',
                    text: 'กรุณาลองอีกครั้ง หรือตรวจสอบการเชื่อมต่ออินเทอร์เน็ต'
                  });
                }
              }
            }
          </script>
    </body>
</html>
