<html>
    <head>
        <%-include('include/head')%>
        <style>
            td {
                padding: 0 10px;
            }
            table {
                font-size: 14px;
            }
        </style>
    </head>
    <body class="<%= receipt_size === '80x80' ? 'thermal-receipt-page' : 'a5-receipt-page' %>">
        <%
        helper = new Helper()
        sum = 0
        discount = bill[0].discount_amount || 0
        %>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
        <% if (receipt_size === '80x80') { %>
        <style>
            .thermal-receipt-page {
                background: #fff;
                color: #111;
            }
            .receipt-thermal {
                width: 80mm;
                min-height: 80mm;
                box-sizing: border-box;
                margin: 0 auto;
                padding: 3mm;
                background: #fff;
                color: #111;
                font-family: 'Prompt', sans-serif;
                font-size: 7pt;
                line-height: 1.25;
            }
            .receipt-thermal h1,
            .receipt-thermal p {
                margin: 0;
            }
            .receipt-thermal .receipt-heading {
                padding-bottom: 2mm;
                border-bottom: 1px dashed #555;
                text-align: center;
            }
            .receipt-thermal .receipt-company {
                font-size: 10pt;
                font-weight: 600;
                overflow-wrap: anywhere;
            }
            .receipt-thermal .receipt-title {
                margin-top: 1mm;
                font-size: 8pt;
                font-weight: 500;
            }
            .receipt-thermal .receipt-meta {
                display: flex;
                justify-content: space-between;
                gap: 2mm;
                padding: 1.5mm 0;
                border-bottom: 1px dashed #999;
            }
            .receipt-thermal .receipt-customer {
                padding: 1.5mm 0;
                border-bottom: 1px dashed #999;
                overflow-wrap: anywhere;
            }
            .receipt-thermal table {
                width: 100%;
                margin: 1mm 0;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 7pt !important;
            }
            .receipt-thermal th,
            .receipt-thermal td {
                padding: 1mm 0 !important;
                border-bottom: 1px dashed #ccc;
                vertical-align: top;
                overflow-wrap: anywhere;
            }
            .receipt-thermal th {
                font-weight: 500;
            }
            .receipt-thermal .receipt-item-price {
                display: block;
                color: #555;
                font-size: 6pt;
            }
            .receipt-thermal .receipt-totals {
                padding-top: 1mm;
                border-top: 1px dashed #555;
            }
            .receipt-thermal .receipt-total-line {
                display: flex;
                justify-content: space-between;
                gap: 2mm;
                padding: .5mm 0;
            }
            .receipt-thermal .receipt-net {
                margin-top: 1mm;
                padding-top: 1mm;
                border-top: 1px solid #111;
                font-size: 9pt;
                font-weight: 600;
            }
            .receipt-thermal .receipt-thanks {
                margin-top: 2mm;
                padding-top: 1mm;
                border-top: 1px dashed #999;
                text-align: center;
            }
            .receipt-actions {
                width: 80mm;
                margin: 8px auto;
                display: flex;
                justify-content: center;
                gap: 8px;
            }
            @page {
                size: 80mm 80mm;
                margin: 0;
            }
            @media print {
                html,
                body.thermal-receipt-page {
                    width: 80mm;
                    min-height: 80mm;
                    margin: 0 !important;
                    padding: 0 !important;
                    background: #fff !important;
                }
                .receipt-toolbar,
                .receipt-actions {
                    display: none !important;
                }
                .receipt-thermal {
                    margin: 0 !important;
                }
            }
        </style>
        <nav class="navbar navbar-light bg-white receipt-toolbar">
            <div class="navbar-brand"><a href="/billingHistories" class="px-4 py-2 text-decoration-none text-black">
                <i class="fa-solid fa-chevron-left me-2"></i> ย้อนกลับ</a></div>
        </nav>
        <%
            sum = bill.reduce((total, row) => total + parseInt(row.total_price || 0, 10), 0)
        %>
        <main class="receipt-thermal" id="billing_content">
            <header class="receipt-heading">
                <h1 class="receipt-company"><%=user_data[0].company_name%></h1>
                <p class="receipt-title">ใบเสร็จรับเงิน</p>
            </header>
            <section class="receipt-meta">
                <span>เลขที่ #<%=billing_id%></span>
                <span><%=moment(bill[0].created_at).add(543, 'years').format('DD/MM/YYYY HH:mm')%></span>
            </section>
            <section class="receipt-customer">
                <p>ลูกค้า: <%if(bill[0].first_name != null && bill[0].last_name != null) {%><%=bill[0].first_name%> <%=bill[0].last_name%><%} else {%>-<%}%></p>
                <%if(bill[0].phone_number) {%><p>โทร: <%=helper.ThaiPhoneNumber(bill[0].phone_number)%></p><%}%>
            </section>
            <table>
                <colgroup>
                    <col style="width: 54%">
                    <col style="width: 14%">
                    <col style="width: 32%">
                </colgroup>
                <thead>
                    <tr>
                        <th>รายการ</th>
                        <th class="text-end">จำนวน</th>
                        <th class="text-end">รวม</th>
                    </tr>
                </thead>
                <tbody>
                    <%bill.forEach(row => {%>
                    <tr>
                        <td><%=row.name%><span class="receipt-item-price"><%=helper.numberWithCommas(row.price)%> บาท/ชิ้น</span></td>
                        <td class="text-end"><%=row.amount%></td>
                        <td class="text-end"><%=helper.numberWithCommas(row.total_price)%></td>
                    </tr>
                    <%})%>
                </tbody>
            </table>
            <section class="receipt-totals">
                <div class="receipt-total-line"><span>รวม</span><span><%=helper.numberWithCommas(sum)%> บาท</span></div>
                <%if(discount != 0) {%>
                <div class="receipt-total-line"><span>ส่วนลด (<%=discount%>%)</span><span>-<%=helper.numberWithCommas((sum * discount) / 100)%> บาท</span></div>
                <%}%>
                <div class="receipt-total-line receipt-net">
                    <span>ชำระสุทธิ</span>
                    <span><%=helper.numberWithCommas(discount == 0 ? sum : sum - (sum * discount) / 100)%> บาท</span>
                </div>
            </section>
            <p class="receipt-thanks">ขอบคุณที่ใช้บริการ</p>
        </main>
        <div class="receipt-actions">
            <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> พิมพ์ใบเสร็จ</button>
            <button class="btn btn-secondary" onclick="exportToPDF()">ส่งออก PDF 80 × 80 มม.</button>
        </div>
        <% } else { %>
        <nav class="navbar navbar-light bg-white">
            <div class="navbar-brand"><a class="px-4 py-2 text-decoration-none text-black" onclick="window.location=document.referrer">
                <i class="fa-solid fa-chevron-left me-2"></i> ย้อนกลับ</a></div>
        </nav>
        <div class="container bg-white px-5 pb-4" style="width: 1200px" id="billing_content">
            <div class="row text-center mx-2">
                <div class="col-5">
                    <img src="/banner.jpg" alt="" class="img-fluid">
                </div>
                <div class="col-7 pt-5 text-end">
                    <p>ที่อยู่</p>
                </div>
            </div>
            <h5 class="bg-dark text-center text-white p-2 mb-3">ใบเสร็จรับเงิน</h5>
            <div class="d-flex flex-row px-2 my-2 gx-2" style="border: 1px solid #000; border-radius: 10px;">
                <div class="col-9 p-2">
                    <p>ชื่อลูกค้า: <%if(bill[0].first_name != null && bill[0].last_name != null) { %><%=bill[0].first_name%> <%=bill[0].last_name%><% } else {%>-<%}%></p>
                    <p>โทรศัพท์: <%if(bill[0].phone_number != undefined) {%><%=helper.ThaiPhoneNumber(bill[0].phone_number)%><% } else {%>-<%}%></p>
                </div>
                <div class="col-3 p-2 ms-2">
                    <p>เวลา: <%=moment(bill[0].created_at).add(543, 'years').format("DD/MM/YYYY HH:mm:ss")%></p>
                </div>
            </div>
            <table border="1" style="width: 100%;">
                <div class="watermark"></div>
                <thead>
                    <tr style="background: #000; color: #fff; text-align: center;">
                        <th>รายการ</th>
                        <th>จำนวน</th>
                        <th colspan="2">ราคา</th>
                        <!-- <th>ส่วนลด</th> -->
                        <th>จำนวนเงิน</th>
                    </tr>
                </thead>
                <% 
                var sum = 0
                var count = 1
                %>
                <tbody>
                    <%bill.forEach(row => {%>
                        <% sum += parseInt(row.total_price) %>
                        <tr style="text-align: center; line-height: 40px;">
                            <td style="text-align: left;"><%=count%>. <%=row.name%></td>
                            <td style="border-left: 1px solid #000; border-bottom: 0;"><%=row.amount%></td>
                            <td style="text-align: right; border-left: 1px solid #000; border-bottom: 0;" colspan="2"><%=helper.numberWithCommas(row.price)%></td>
                            <!-- <td style="text-align: right; border-left: 1px solid #000; border-bottom: 0;"></td> -->
                            <td style="text-align: right; border: 1px solid #000; border-top: 0; border-bottom: 0;"><%=helper.numberWithCommas(row.total_price)%></td>
                        </tr>
                        <% count++ %>
                    <%})%>
                    <tr style="text-align: right; line-height: 40px; border-top: 1px solid #000;">
                        <td></td>
                        <td style="text-align: center; border: 1px solid #000; border-right: 0;">รวม</td>
                        <td style="border-left: 1px solid #000; border-top: 1px solid #000;" colspan="2"><%=helper.numberWithCommas(sum)%></td>
                        <!-- <td colspan="1" style="border-left: 1px solid #000; border-top: 1px solid #000;" colspan="1"></td> -->
                        <td style="border-top: 1px solid #000; border-left: 1px solid #000;"><%=helper.numberWithCommas(sum)%></td>
                    </tr>
                    <tr style="text-align: left; line-height: 40px;">
                        <td colspan="4">
                        </td>
                        <!-- <td colspan="2" style="border: 1px solid #000; border-bottom: 0; border-right: 0;"><b>มัดจำ</b></td>
                        <td class="text-end" style="border-left: 1px solid #000;">
                        -
                        </td> -->
                    </tr>
                    <%if(discount != 0) {%>
                    <tr style="text-align: left; line-height: 40px;">
                        <td colspan="2">                       
                        </td>
                        <td colspan="2" style="border: 1px solid #000; border-bottom: 0; border-right: 0;"><b>ส่วนลด:</b></td>
                            
                        <td class="text-end" style="border: 1px solid #000; border-bottom: 0; border-right: 0;"><%=bill[0].discount_amount%> %</td>
                    </tr>
                    <%}%>
                    <tr style="text-align: left; line-height: 40px;">
                        <td colspan="2">                       
                        </td>
                        <td colspan="2" style="border: 0px solid #000; border-top: 0; border-bottom: 0; border-right: 0;" class="bg-dark text-white"><b>ชำระสุทธิ:</b></td>
                        
                        <%if(discount == 0) {%>
                            <td class="text-end bg-dark text-white"><%=helper.numberWithCommas(sum)%>.-</td>
                        <%} else {%>
                        <td class="text-end bg-dark text-white"><%=helper.numberWithCommas(sum - (sum*discount)/100)%>.-</td>
                        <%}%>
                    </tr>
                </tbody>
            </table>
            <div class="p-4 bg-secondary text-white">

            </div>
        </div>
        <div class="container text-end my-4" style="width: 1200px;">
            <button class="btn btn-primary" onclick="exportToPDF()">ส่งออกเป็น PDF</button>
        </div>
        <% } %>
        <script>
            function exportToPDF() {
              const { jsPDF } = window.jspdf;
              const isThermalReceipt = <%-JSON.stringify(receipt_size === '80x80')%>;
              const pdf = isThermalReceipt
                ? new jsPDF('p', 'mm', [80, 80])
                : new jsPDF('l', 'mm', 'a5');
          
              const content = document.getElementById('billing_content');
              
              html2canvas(content).then((canvas) => {
                const imgData = canvas.toDataURL('image/png');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const imgWidth = canvas.width;
                const imgHeight = canvas.height;
                const ratio = Math.min(pageWidth / imgWidth, pageHeight / imgHeight);
                
                const renderedWidth = imgWidth * ratio;
                const renderedHeight = imgHeight * ratio;
                const x = isThermalReceipt ? (pageWidth - renderedWidth) / 2 : 0;
                pdf.addImage(imgData, 'PNG', x, 0, renderedWidth, renderedHeight);
                pdf.save(isThermalReceipt ? 'ใบเสร็จรับเงิน-80x80.pdf' : 'ใบเสร็จรับเงิน.pdf');
              });
            }
          </script>
    </body>
</html>
