<html>
    <head>
        <title>ประวัติการขายสินค้า | SunnyPOS</title>
        <%-include('include/head')%>
    </head>
    <body>
        <script>
            let billingRequest;
            searchByCustomer('<%=customer_id%>')

            function searchByCustomer(owner, page = 1) {
                if (billingRequest) billingRequest.abort();
                billingRequest = new AbortController();
                const params = new URLSearchParams({ customer_id: owner, page: String(page) });
                fetch(`/getBillingHistoriesByCustomer?${params}`, { signal: billingRequest.signal })
                    .then(async response => {
                        if (!response.ok) throw new Error('ไม่สามารถโหลดประวัติบิลได้');
                        return response.text();
                    })
                    .then(html => {
                        const container = document.getElementById('billingHistoriesHTML');
                        if (window.replaceTableContent) replaceTableContent(container, html);
                        else container.innerHTML = html;
                    })
                    .catch(error => {
                        if (error.name === 'AbortError') return;
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                        });
                    });
            }

            document.addEventListener('click', event => {
                const control = event.target.closest('#billingHistoriesHTML [data-page]');
                if (control) {
                    event.preventDefault();
                    if (control.getAttribute('aria-disabled') !== 'true') {
                        searchByCustomer(document.getElementById('search_by_owner').value, Number(control.dataset.page));
                    }
                }
            });
        </script>
        <div class="d-flex app-shell">
            <%-include('include/sidebar')%>
            <div class="container-fluid p-0 overflow-hidden app-main">
                <!-- <nav class="navbar">
                    <div class="navbar-brand"><a class="px-4 py-2 text-decoration-none text-black" onclick="history.back()">
                        <i class="fa-solid fa-chevron-left me-4"></i> ประวัติการขายสินค้า</a></div>
                </nav> -->
                <%-include('include/navigator')%>
                <div class="container-fluid p-4 app-content">
                    <div class="card p-4">
                        <h2 class="mb-4"><i class="fa-solid fa-file-invoice-dollar me-1"></i> ประวัติการขายสินค้า</h2>
                        <div class="row mb-4">
                            <div class="col">
                                <select class="form-select" id="search_by_owner" onchange="searchByCustomer(this.value)">
                                    <option value="all">เลือกลูกค้าทั้งหมด</option>
                                    <% owners.forEach(row => {
                                    %>
                                    <option value="<%=row.id%>" <%if(row.id == customer_id) {%>selected<%}%>><%=row.first_name%> <%=row.last_name%></option>
                                    <%
                                    }) 
                                    %>
                                </select>
                            </div>
                        </div>
                        <div id="billingHistoriesHTML"></div>
                    </div>
                </div>
            </div>
        </div>
        <%-include('include/footer')%>
    </body>
</html>
