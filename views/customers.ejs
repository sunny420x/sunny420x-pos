<html>
    <head>
        <title>รายชื่อลูกค้า | OpenPOS</title>
        <%-include('include/head')%>
    </head>
    <body>
        <%
        helper = new Helper()
        %>
        <script>
            let customerSearchType = 'fullName';
            let customerSearchQuery = '';
            let customerRequest;
            let customerSearchTimer;

            function loadCustomers(type, query, page = 1) {
                customerSearchType = type;
                customerSearchQuery = query;
                if (customerRequest) customerRequest.abort();
                customerRequest = new AbortController();

                const endpoints = {
                    fullName: '/searchCustomerByFullName',
                    phoneNumber: '/searchCustomerByPhoneNumber'
                };
                const params = new URLSearchParams({ q: query, page: String(page) });

                fetch(`${endpoints[type]}?${params}`, { signal: customerRequest.signal })
                    .then(async response => {
                        if (!response.ok) throw new Error('ไม่สามารถโหลดข้อมูลลูกค้าได้');
                        return response.text();
                    })
                    .then(html => {
                        const container = document.getElementById('customerHTML');
                        if (window.replaceTableContent) replaceTableContent(container, html);
                        else container.innerHTML = html;
                    })
                    .catch(error => {
                        if (error.name === 'AbortError') return;
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                        });
                    });
            }

            document.addEventListener('click', event => {
                const control = event.target.closest('#customerHTML [data-page]');
                if (control) {
                    event.preventDefault();
                    if (control.getAttribute('aria-disabled') !== 'true') {
                        loadCustomers(customerSearchType, customerSearchQuery, Number(control.dataset.page));
                    }
                }
            });

            document.addEventListener('DOMContentLoaded', () => {
                const nameInput = document.getElementById('search_customer_by_fullname');
                const phoneInput = document.getElementById('search_customer_by_phone_number');
                const search = (type, input) => {
                    window.clearTimeout(customerSearchTimer);
                    customerSearchTimer = window.setTimeout(() => {
                        loadCustomers(type, input.value.trim());
                    }, 250);
                };

                nameInput.addEventListener('input', () => search('fullName', nameInput));
                phoneInput.addEventListener('input', () => search('phoneNumber', phoneInput));
                loadCustomers('fullName', '');
            });
        </script>
        <div class="d-flex app-shell">
            <%-include('include/sidebar')%>
            <div class="container-fluid p-0 overflow-hidden app-main">
                <!-- <nav class="navbar">
                    <div class="navbar-brand"><a class="px-4 py-2 text-decoration-none text-black" onclick="history.back()">
                        <i class="fa-solid fa-chevron-left me-4"></i> รายชื่อลูกค้า</a></div>
                </nav> -->
                <%-include('include/navigator')%>
                <div class="container-fluid p-4 app-content">
                    <div class="card p-4">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="search_customer_by_fullname">ค้นหาจากชื่อ-นามสกุล</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
                                    <input type="search" class="form-control" placeholder="พิมพ์ชื่อหรือนามสกุล" id="search_customer_by_fullname" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="search_customer_by_phone_number">ค้นหาจากเบอร์โทรศัพท์</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
                                    <input type="search" class="form-control" placeholder="พิมพ์เบอร์โทรศัพท์" id="search_customer_by_phone_number" inputmode="tel" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <h2 class="mt-2 mb-4"><i class="fa-solid fa-users me-1"></i> รายชื่อลูกค้า <button type="button" class="btn btn-primary btn-sm" onclick="openLink('/addCustomer')"><i class="fa-solid fa-plus me-1"></i> เพิ่มข้อมูลลูกค้า</button></h2>
                        <div class="row">
                            <div id="customerHTML"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%-include('include/footer')%>
    </body>
</html>
