<html>
    <head>
        <title>แก้ไขประเภทผู้ใช้ | OpenPOS</title>
        <%-include('include/head')%>
        <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet">
        <style>
            .select2-container {
                width: 100% !important;
            }
        </style>
    </head>
    <body>
        <div class="d-flex app-shell">
            <%-include('include/sidebar')%>
            <div class="container-fluid p-0 overflow-hidden app-main">
                <nav class="navbar">
                    <div class="navbar-brand"><a class="px-4 py-2 text-decoration-none text-black" href="/user_types">
                        <i class="fa-solid fa-chevron-left me-4"></i> แก้ไขประเภทผู้ใช้</a></div>
                </nav>
                <%-include('include/navigator')%>
                <div class="container-fluid p-4 app-content">
                    <div class="card p-4">
                        <h2 class="mb-4"><i class="fa-solid fa-users-cog me-1"></i> แก้ไขข้อมูลผู้ใช้</h2>
                        <form action="/editUserType" method="post">
                            <input type="hidden" name="id" value="<%=row.id%>">
                            <div class="mb-3">
                                <div class="form-floating">
                                    <input type="text" class="form-control" placeholder="กรอกชื่อประเภท" id="name" name="name" value="<%=row.name%>" required>
                                    <label for="name">ชื่อประเภท *</label>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="permission" class="form-label">สิทธิ์ผู้ใช้ *</label>
                                <% const selectedPermissions = new Set(String(row.permission || '').split(',').map(permission => permission.trim())); %>
                                <select class="form-select" id="permission" name="permission" multiple required>
                                    <option value="customers" <%=selectedPermissions.has('customers') ? 'selected' : ''%>>customers — จัดการลูกค้า</option>
                                    <option value="products" <%=selectedPermissions.has('products') ? 'selected' : ''%>>products — จัดการสินค้า</option>
                                    <option value="bills" <%=selectedPermissions.has('bills') ? 'selected' : ''%>>bills — จัดการประวัติการซื้อ</option>
                                    <option value="users" <%=selectedPermissions.has('users') ? 'selected' : ''%>>users — จัดการผู้ใช้ในระบบ</option>
                                </select>
                                <div class="form-text">เลือกสิทธิ์ได้มากกว่าหนึ่งรายการ</div>
                            </div>
                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> บันทึกการเปลี่ยนแปลง</button>
                        </form>
                    </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <script>
        $(function () {
            $('#permission').select2({
                placeholder: 'เลือกสิทธิ์ผู้ใช้',
                closeOnSelect: false
            });
        });
    </script>
    <%-include('include/footer')%>
    </body>
</html>