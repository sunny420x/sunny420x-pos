<html>
    <head>
        <title>หน้าหลัก | SunnyPOS</title>
        <%-include('include/head')%>
    </head>
    <body>
        <% helper = new Helper() %>
        <div class="d-flex app-shell">
            <%-include('include/sidebar')%>
            <div class="container-fluid p-0 overflow-hidden app-main">
                <%-include('include/navigator')%>
                <div class="container-fluid p-4 app-content">
                    <div class="card p-4">
                        <div class="stats-grid">
                            <% if (stock_mode !== 'inventory_only') { %>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-star me-1"></i> สินค้าขายดี</h3>
                                <% if(bestseller) { %>
                                <span class="fs-4 text-secondary"><%=bestseller.name%></span>
                                <%} else {%>
                                <span class="fs-4 text-secondary">-</span>
                                <%}%>
                            </div>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-box-open me-1"></i> ขายได้เดือนนี้</h3>
                                <span class="fs-4 text-secondary"><%=helper.numberWithCommas(productSellingChart.reduce((total, row) => total + Number(row.amounts), 0))%> รายการ</span>
                            </div>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-coins me-1"></i> ยอดขายเดือนนี้</h3>
                                <span class="fs-4 text-secondary"><%=helper.numberWithCommas(total_sales)%> บาท</span>
                            </div>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-coins me-1"></i> กำไรเดือนนี้</h3>
                                <span class="fs-4 text-secondary"><%=helper.numberWithCommas(profits)%> บาท</span>
                            </div>
                            <% } else { %>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-boxes-stacked me-1"></i> สต๊อกคงเหลือ</h3>
                                <span class="fs-4 text-secondary"><%=helper.numberWithCommas(stockByProductType.reduce((total, row) => total + Number(row.amounts), 0))%> ชิ้น</span>
                            </div>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-arrow-right-from-bracket me-1"></i> ตัดออกเดือนนี้</h3>
                                <span class="fs-4 text-secondary"><%=helper.numberWithCommas(stockMovementChart.reduce((total, row) => total + Number(row.outgoing), 0))%> ชิ้น</span>
                            </div>
                            <% } %>
                            <div class="card text-bg-light p-4">
                                <h3><i class="fa-solid fa-users me-1"></i> ลูกค้าในระบบ</h3>
                                <span class="fs-4 text-secondary"><%=helper.numberWithCommas(total_customers.amounts)%> คน</span>
                            </div>
                        </div>

                        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

                        <div class="row g-4">
                        <% if (stock_mode !== 'inventory_only') { %>
                        <div class="col-12 col-xl-6">
                            <div class="card h-100 p-4">
                                <h2><i class="fa-solid fa-chart-simple px-2"></i>ยอดขายสินค้าของเดือนนี้</h2>
                                <p class="text-secondary">จำนวนสินค้าที่ขายได้ในแต่ละวันของเดือนนี้</p>
                                <div class="dashboard-chart"><canvas id="sellProductChart"></canvas></div>
                            </div>
                        </div>

                        <script>
                        const sellProductChart = document.getElementById('sellProductChart');

                        new Chart(sellProductChart, {
                            type: 'line',
                            data: {
                            labels: [<%- productSellingChart.map(item => `"${moment(item.days).format('DD/MM/YY')}"`).join(", ") %>],
                            datasets: [{
                                label: 'จำนวนชิ้น',
                                data: [<%- productSellingChart.map(item => item.amounts).join(", ") %>],
                                tension: 0.3,
                                borderWidth: 2
                            }]
                            },
                            options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: {
                                beginAtZero: true
                                }
                            }
                            }
                        });
                        </script>
                        <% } %>

                            <div class="col-12 col-xl-6">
                                <div class="card h-100 p-4">
                                    <h2><i class="fa-solid fa-boxes-stacked me-2"></i>สต๊อกคงเหลือตามประเภท</h2>
                                    <p class="text-secondary">จำนวนชิ้นที่ยังไม่ถูกตัดออก แยกตามประเภทสินค้า</p>
                                    <% if (stockByProductType.length) { %>
                                    <div class="dashboard-chart"><canvas id="stockByTypeChart"></canvas></div>
                                    <% } else { %><p class="text-secondary mb-0">ยังไม่มีสินค้าในสต๊อก</p><% } %>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6">
                                <div class="card h-100 p-4">
                                    <h2><i class="fa-solid fa-arrow-right-arrow-left me-2"></i>การเคลื่อนไหวสต๊อก</h2>
                                    <p class="text-secondary">จำนวนรับเข้าและตัดออกในแต่ละวันของเดือนนี้</p>
                                    <% if (stockMovementChart.length) { %>
                                    <div class="dashboard-chart"><canvas id="stockMovementChart"></canvas></div>
                                    <% } else { %><p class="text-secondary mb-0">ยังไม่มีการเคลื่อนไหวสต๊อกในเดือนนี้</p><% } %>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6">
                                <div class="card h-100 p-4">
                                    <h2><i class="fa-solid fa-calendar-days me-2"></i>สถานะวันหมดอายุ</h2>
                                    <p class="text-secondary">จำนวนชิ้นที่ยังเหลือ แบ่งตามกำหนดวันหมดอายุ</p>
                                    <% if (expiryStatusChart.length) { %>
                                    <div class="dashboard-chart"><canvas id="expiryStatusChart"></canvas></div>
                                    <% } else { %><p class="text-secondary mb-0">ยังไม่มีข้อมูลสต๊อก</p><% } %>
                                </div>
                            </div>
                        </div>

                        <script>
                        <% if (stockByProductType.length) { %>
                        new Chart(document.getElementById('stockByTypeChart'), {
                            type: 'doughnut',
                            data: {
                                labels: <%- JSON.stringify(stockByProductType.map(row => row.name)).replace(/</g, '\\u003c') %>,
                                datasets: [{
                                    label: 'จำนวนคงเหลือ',
                                    data: <%- JSON.stringify(stockByProductType.map(row => Number(row.amounts))) %>,
                                    backgroundColor: ['#6f42c1', '#0d6efd', '#20c997', '#fd7e14', '#d63384', '#0dcaf0', '#198754', '#ffc107'],
                                    borderWidth: 1
                                }]
                            },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                        });
                        <% } %>

                        <% if (stockMovementChart.length) { %>
                        new Chart(document.getElementById('stockMovementChart'), {
                            type: 'bar',
                            data: {
                                labels: <%- JSON.stringify(stockMovementChart.map(row => moment(row.days).format('DD/MM'))) %>,
                                datasets: [
                                    { label: 'รับเข้า', data: <%- JSON.stringify(stockMovementChart.map(row => Number(row.incoming))) %>, backgroundColor: '#20a36a' },
                                    { label: 'ตัดออก', data: <%- JSON.stringify(stockMovementChart.map(row => Number(row.outgoing))) %>, backgroundColor: '#e35d6a' }
                                ]
                            },
                            options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }, plugins: { legend: { position: 'bottom' } } }
                        });
                        <% } %>

                        <% if (expiryStatusChart.length) { %>
                        const expiryLabels = <%- JSON.stringify(expiryStatusChart.map(row => row.status)).replace(/</g, '\\u003c') %>;
                        new Chart(document.getElementById('expiryStatusChart'), {
                            type: 'doughnut',
                            data: {
                                labels: expiryLabels,
                                datasets: [{
                                    label: 'จำนวนคงเหลือ',
                                    data: <%- JSON.stringify(expiryStatusChart.map(row => Number(row.amounts))) %>,
                                    backgroundColor: expiryLabels.map(label => label === 'หมดอายุแล้ว' ? '#dc3545' : label === 'หมดอายุใน 30 วัน' ? '#ffc107' : label === 'ไม่กำหนดวันหมดอายุ' ? '#6c757d' : '#198754'),
                                    borderWidth: 1
                                }]
                            },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                        });
                        <% } %>
                        </script>

                        <h2 class="my-4"><i class="fa-solid fa-trash mx-1"></i> สินค้าหมดอายุ</h2>
                        <div class="table-responsive">
                            <table class="table data-table">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th>หมายเลขนำเข้า</th>
                                        <th>ประเภท</th>
                                        <th>ชื่อสินค้า</th>
                                        <th>จำนวน</th>
                                        <th>สถานะ</th>
                                        <th>หมดอายุเมื่อ</th>
                                        <th class="no-sort">จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody class="text-center">
                                <% expired_products.forEach((row) => { %>
                                    <tr class="text-center">
                                        <td><%=row.id%></td>
                                        <td><%=row.type%></td>
                                        <td><%=row.name%></td>
                                        <td><%=row.value%></td>
                                        <td><%if(row.expired_date != null) {%><%if(moment(row.expired_date).diff(moment(), 'days') > 0) {%><span class="badge text-bg-secondary">หมดอายุในอีก <%=moment(row.expired_date).diff(moment(), 'days')%> วัน<%} else {%><span class="badge text-bg-danger">หมดอายุแล้ว</span><%}%><%} else {%>-<%}%></span></td>
                                        <td data-order="<%=row.expired_date ? moment(row.expired_date).valueOf() : ''%>"><%=moment(row.expired_date).format('DD/MM/YYYY')%></td>
                                        <td>
                                            <button class="btn btn-danger" onclick="
                                            Swal.fire({
                                            title: 'คุณต้องการลบข้อมูลนี้หรือไม่?',
                                            text: 'การลบจะไม่สามารถย้อนกลับได้',
                                            icon: 'warning',
                                            showCancelButton: true,
                                            confirmButtonColor: '#3085d6',
                                            cancelButtonColor: '#d33',
                                            confirmButtonText: 'ยืนยัน',
                                            cancelButtonText: 'ย้อนกลับ',
                                            }).then((result) => {
                                            if (result.isConfirmed) {
                                                openLink('/deleteProductByTransction/<%=row.id%>')
                                            }
                                            });
                                            "><i class="fa-solid fa-trash"></i></button>
                                        </td>
                                    </tr>
                                <%})%>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%-include('include/footer')%>
    </body>
</html>
