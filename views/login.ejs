<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <title>เข้าสู่ระบบ | SunnyPOS</title>
    <%- include('include/head') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-page">
    <main class="auth-layout">
        <%- include('include/auth_brand') %>
        <section class="card auth-card" aria-labelledby="auth-title">
            <div class="auth-card-heading"><span class="auth-icon"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i></span><div><h1 id="auth-title">เข้าสู่ระบบ</h1><p>เลือกบริษัทและเข้าสู่ระบบเพื่อเริ่มงาน</p></div></div>
            <% if(error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
            <% if(!companies.length) { %><div class="alert alert-info" role="status">ยังไม่มีบริษัทในระบบ เริ่มต้นด้วยการสมัครบริษัทใหม่</div><% } %>
            <form method="post" action="/login">
                <div class="mb-3">
                    <label for="company_code" class="form-label">บริษัท</label>
                    <select id="company_code" name="company_code" class="form-select" required <%= !companies.length ? 'disabled' : '' %>>
                        <option value="" disabled <%= !company_code ? 'selected' : '' %>>เลือกบริษัทของคุณ</option>
                        <% companies.forEach(company => { %><option value="<%= company.code %>" <%= company_code === company.code ? 'selected' : '' %>><%= company.name %></option><% }) %>
                    </select>
                </div>
                <div class="mb-3"><label for="username" class="form-label">ชื่อผู้ใช้</label><input id="username" name="username" class="form-control" autocomplete="username" value="<%= username %>" placeholder="ชื่อผู้ใช้ของคุณ" required maxlength="100"></div>
                <div class="mb-4"><label for="password" class="form-label">รหัสผ่าน</label><input id="password" name="password" type="password" class="form-control" autocomplete="current-password" placeholder="กรอกรหัสผ่าน" required maxlength="128"></div>
                <button class="btn btn-primary auth-submit w-100" <%= !companies.length ? 'disabled' : '' %>><i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>เข้าสู่ระบบ</button>
            </form>
            <p class="auth-switch">ยังไม่มีบริษัทในระบบ? <a href="/register">สมัครบริษัทใหม่ <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></a></p>
        </section>
        <p class="auth-footer">SunnyPOS · ระบบจัดการร้านค้า</p>
    </main>
</body>
</html>
