<html>
    <head>
        <title><%= stock_mode === 'inventory_only' ? 'รายการสต๊อก' : 'รายการสินค้าในระบบ' %> | OpenPOS</title>
        <%-include('include/head')%>
    </head>
    <body>
        <% const availableCartAssets = typeof cartAssets === 'undefined' ? [] : cartAssets; %>
        <script>
            let cart = []
            let assetAdjustments = new Map()
            let totals = 0
            let _type = "<%=type%>"
            let _name = ''
            let productStockRequest;
            let productSearchTimer;

            function searchByType(type, page = 1, updateHistory = true) {
                if (productStockRequest) productStockRequest.abort();
                productStockRequest = new AbortController();
                _type = type;
                const params = new URLSearchParams({ type, option: '<%=option%>', page: String(page), name: _name });
                const container = document.getElementById('productStock');
                showLoadingSkeleton(container, '<%=option%>' === 'catalog' ? 'catalog' : 'table', 6);
                fetch(`/getProductStock?${params}`, { signal: productStockRequest.signal })
                .then(async response => {
                    if (!response.ok) throw new Error('ไม่สามารถโหลดรายการสินค้าได้');
                    return response.text();
                })
                .then(data => {
                    if (window.replaceTableContent) replaceTableContent(container, data);
                    else {
                        container.innerHTML = data;
                        container.removeAttribute('aria-busy');
                    }

                    const query = new URLSearchParams({ type: _type, option: '<%=option%>', page: String(page) });
                    if (_name) query.set('name', _name);
                    if (updateHistory) history.pushState('', '', `?${query}`);
                })
                .catch(error => {
                    if (error.name === 'AbortError') return;
                    console.error('Error:', error);
                    showLoadingError(container, 'โหลดรายการสินค้าไม่สำเร็จ กรุณาลองใหม่');
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                    });
                });  
            }

            document.addEventListener('click', event => {
                const control = event.target.closest('#productStock [data-page]');
                if (control) {
                    event.preventDefault();
                    if (control.getAttribute('aria-disabled') !== 'true') {
                        searchByType(_type, Number(control.dataset.page));
                    }
                }
            });

            function selectOption(value) {
                const params = new URLSearchParams({ type: _type, option: value });
                if (_name) params.set('name', _name);
                window.location.href=`/products_stock?${params}`
            }

            document.addEventListener('DOMContentLoaded', () => {
                const nameSearch = document.getElementById('search_product_name');
                _name = new URLSearchParams(window.location.search).get('name')?.trim() || '';
                nameSearch.value = _name;
                nameSearch.addEventListener('input', () => {
                    window.clearTimeout(productSearchTimer);
                    productSearchTimer = window.setTimeout(() => searchByType(_type), 250);
                });
                searchByType(_type);
            });

            function deductStockFromButton(button) {
                const productType = button.dataset.type
                const productName = button.dataset.name
                Swal.fire({
                    title: 'ตัดสต๊อกสินค้า',
                    text: productName,
                    input: 'number',
                    inputValue: 1,
                    inputAttributes: { min: 1, max: 1000, step: 1 },
                    showCancelButton: true,
                    confirmButtonText: 'ตัดสต๊อก',
                    cancelButtonText: 'ยกเลิก',
                    inputValidator: value => {
                        const amount = Number(value)
                        if (!Number.isSafeInteger(amount) || amount < 1 || amount > 1000) {
                            return 'กรุณาระบุจำนวน 1–1000 ชิ้น'
                        }
                    }
                }).then(result => {
                    if (!result.isConfirmed) return
                    const amount = Number(result.value)
                    fetch('/deductStock', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            product_type: productType,
                            product_name: productName,
                            amount: amount
                        })
                    })
                    .then(async response => {
                        const data = await response.json()
                        if (!response.ok) throw new Error(data.error || 'ตัดสต๊อกไม่สำเร็จ')
                        return data
                    })
                    .then(() => Swal.fire({
                        icon: 'success',
                        title: 'ตัดสต๊อกสำเร็จ',
                        text: `${productName} จำนวน ${amount} ชิ้น`
                    }).then(() => searchByType(_type)))
                    .catch(error => Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'โปรดลองอีกครั้งในภายหลัง'
                    }))
                })
            }
        </script>
        <div class="d-flex app-shell">
            <%-include('include/sidebar')%>
            <div class="container-fluid p-0 overflow-hidden app-main">
                <%-include('include/navigator')%>
                <div class="container-fluid p-4 app-content">
                    <div class="card p-4">
                        <h2 class="mb-4"><i class="fa-solid fa-boxes me-1"></i> <%= stock_mode === 'inventory_only' ? 'รายการสต๊อก' : 'รายการสินค้าในระบบ' %>
                            <% if (stock_mode === 'pos') { %>
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#sell_modal"><i class="fa-solid fa-shopping-cart me-1"></i> รถเข็น</button>
                            <% } %>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addStock_modal"><i class="fa-solid fa-plus me-1"></i> เพิ่มข้อมูลการนำเข้าสินค้า</button>
                        </h2>
                        <div class="row g-2 mb-3">
                            <div class="col-lg">
                                <select class="form-select" id="search_by_type" data-persist-filter data-query-param="type" onchange="searchByType(this.value, 1, !window.__sunny420xRestoringFilters)">
                                    <option value="all">เลือกทุกประเภท</option>
                                    <% product_types.forEach(row => {
                                    %>
                                    <option value="<%=row.id%>" <%if(row.id == type) {%>selected<%}%>><%=row.name%></option>
                                    <%
                                    }) 
                                    %>
                                </select>
                            </div>
                            <div class="col-lg-3">
                                <select id="product_view_mode" data-persist-filter data-query-param="option" onchange="window.__sunny420xRestoringFilters ? null : selectOption(this.value)" class="form-select">
                                    <option value="list" <%if(option == 'list') {%>selected<%}%>>List View</option>
                                    <option value="catalog" <%if(option == 'catalog') {%>selected<%}%>>Catalog View</option>
                                </select>
                            </div>
                            <div class="col-lg-4">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                                    <input type="search" class="form-control" id="search_product_name" placeholder="ค้นหาชื่อสินค้า" autocomplete="off" aria-label="ค้นหาชื่อสินค้า">
                                </div>
                            </div>
                        </div>
                        <div id="productStock"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="addStock_modal" tabindex="-1" aria-labelledby="addStock_modal" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5" id="modal_title">เพิ่มข้อมูลการนำเข้าสินค้า</h1>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="form-floating">
                            <select class="form-select" id="type">
                                <option value="">เลือกประเภทสินค้า</option>
                                <% product_types.forEach(row => {
                                %>
                                <option value="<%=row.id%>"><%=row.name%></option>
                                <%
                                }) 
                                %>
                            </select>
                            <label for="type">เลือกประเภทสินค้า: </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <button onclick="getProductsHistoriesByType()" class="btn btn-secondary btn-sm"><i class="fa-solid fa-box-open me-1"></i> เลือกจากในระบบ</button>
                        <button onclick="resetProductName()" class="btn btn-secondary btn-sm"><i class="fa-solid fa-plus me-1"></i> เพิ่มสินค้าใหม่</button>
                    </div>
                    <div id="productNameSelectBox"></div>
                    <div class="mb-3">
                        <% if (stock_mode === 'pos') { %>
                        <div class="form-floating">
                            <select id="tracking_mode" class="form-select" onchange="toggleStockAmount()">
                                <option value="quantity">สต๊อกตามจำนวน</option>
                                <option value="availability">สต๊อกแบบมี / หมด</option>
                            </select>
                            <label for="tracking_mode">รูปแบบสต๊อกสินค้า</label>
                        </div>
                        <% } %>
                    </div>
                    <div class="mb-3" id="amount_wrapper">
                        <div class="form-floating">
                            <input type="number" class="form-control" placeholder="กรอกจำนวน" id="amount" name="amount" min="1" value="1" required>
                            <label for="amount">จำนวน *</label>
                        </div>
                    </div>
                    <% if (stock_mode === 'pos') { %>
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="number" class="form-control" placeholder="กรอกราคา" id="import_price" name="import_price" min="1" value="0">
                            <label for="import_price">ราคาซื้อ (ต่อหน่วย)</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="number" class="form-control" placeholder="กรอกราคา" id="price" name="price" min="1" value="0" required>
                            <label for="price">ราคาขาย (ต่อหน่วย) *</label>
                        </div>
                    </div>
                    <% } %>
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="date" class="form-control" placeholder="กรอกวันหมดอายุ" id="expired_date" name="expired_date">
                            <label for="expired_date">วันหมดอายุ (ถ้ามี)</label>
                        </div>
                    </div>
                </div>
                <script>
                    const stock_mode = <%- JSON.stringify(stock_mode) %>
                    resetProductName()

                    function resetProductName() {
                        document.getElementById('productNameSelectBox').innerHTML = `
                        <div class="mb-3">
                            <div class="form-floating">
                                <input type="text" class="form-control" placeholder="กรอกชื่อสินค้า" id="name" name="name" required>
                                <label for="vaccine_name">ชื่อสินค้า *</label>
                            </div>
                        </div>`
                    }
                    function toggleStockAmount() {
                        const availabilityMode = document.getElementById('tracking_mode')?.value === 'availability';
                        const amount = document.getElementById('amount');
                        document.getElementById('amount_wrapper').hidden = availabilityMode;
                        amount.required = !availabilityMode;
                        if (availabilityMode) amount.value = 1;
                    }
                    function getProductsHistoriesByType() {
                        let type = document.getElementById('type').value
                        const container = document.getElementById('productNameSelectBox');
                        showLoadingSkeleton(container, 'select', 1);

                        fetch('/getProductsHistoriesByType?type='+type)
                        .then(res => {
                            if (!res.ok) {
                                return res.json().then(errorData => { throw new Error(errorData.error); });
                            }
                            return res.text();
                        })
                        .then(data => {
                            container.innerHTML = data;
                            container.removeAttribute('aria-busy');
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showLoadingError(container, 'โหลดรายการสินค้าไม่สำเร็จ กรุณาลองใหม่');
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                            });
                        });  
                    }
                    function addProductStock() {
                        let name = document.getElementById('name').value
                        let type = document.getElementById('type').value
                        let amount = document.getElementById('amount').value
                        let tracking_mode = stock_mode === 'pos' ? document.getElementById('tracking_mode').value : 'quantity'
                        let price = stock_mode === 'pos' ? document.getElementById('price').value : 0
                        let import_price = stock_mode === 'pos' ? document.getElementById('import_price').value : null
                        let expired_date = document.getElementById('expired_date').value

                        const options = {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            name: name,
                            type:type,
                            amount: amount,
                            tracking_mode: tracking_mode,
                            price:price,
                            import_price:import_price,
                            expired_date:expired_date
                        })
                        };

                        if(!name || !type || (tracking_mode === 'quantity' && !amount)) {
                            Swal.fire({
                                icon: 'error',
                                title: 'โปรดกรอกข้อมูลการการนำเข้าสินค้าให้ครบถ้วน'
                            });
                            return;
                        }

                        fetch('/addProductStock', options)
                        .then(res => {
                            if (!res.ok) {
                                return res.json().then(errorData => { throw new Error(errorData.error); });
                            }
                            return res.json();
                        })
                        .then(data => {
                            Swal.fire({
                                icon: 'success',
                                title: 'เพิ่มข้อมูลสินค้าแล้ว!',
                            }).then(() => {
                                location.reload()
                            });
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                            });
                        });  
                    }
                </script>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-cancel me-1"></i> ยกเลิก</button>
                  <button type="button" class="btn btn-primary" onclick="addProductStock()"><i class="fa-solid fa-plus me-1"></i> เพิ่มข้อมูลการนำเข้าสินค้า</button>
                </div>
              </div>
            </div>
        </div>
        <% if (stock_mode === 'pos') { %>
        <div class="modal fade" id="sell_modal" tabindex="-1" aria-labelledby="sell_modal_title" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable sell-modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <div>
                    <h1 class="modal-title fs-5" id="sell_modal_title"><i class="fa-solid fa-cash-register me-2"></i>ขายสินค้า</h1>
                    <p class="text-secondary small mb-0">เลือกสินค้าจากแคตตาล็อก แล้วตรวจสอบรายการก่อนยืนยัน</p>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body sell-modal-body">
                    <div class="row g-4">
                        <section class="col-lg-7 sell-catalog-panel" aria-labelledby="sell_catalog_heading">
                            <div class="sell-panel-heading">
                                <div>
                                    <h2 id="sell_catalog_heading" class="h5 mb-1">แคตตาล็อกสินค้า</h2>
                                    <p class="text-secondary small mb-0">กดการ์ดสินค้าเพื่อเพิ่มลงในรายการ</p>
                                </div>
                                <span class="sell-step-badge">1</span>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-sm-5">
                                    <label class="form-label small" for="sell_product_type">หมวดหมู่สินค้า</label>
                                    <select class="form-select" id="sell_product_type" onchange="initProductType(this.value)">
                                        <% if (!product_types.length) { %>
                                        <option value="">ไม่มีหมวดหมู่สินค้า</option>
                                        <% } else { %>
                                        <% product_types.forEach((row, index) => { %>
                                        <option value="<%=row.id%>" <%=index === 0 ? 'selected' : ''%>><%=row.name%></option>
                                        <% }) %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-sm-7">
                                    <label class="form-label small" for="sell_product_search">ค้นหาสินค้า</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                                        <input type="search" class="form-control" id="sell_product_search" placeholder="พิมพ์ชื่อสินค้า..." autocomplete="off">
                                    </div>
                                </div>
                            </div>
                            <div id="productSelectBox" class="sell-catalog-results" aria-live="polite">
                                <div class="sell-empty-state">
                                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                                    <p class="mb-0">เลือกหมวดหมู่เพื่อดูสินค้า</p>
                                </div>
                            </div>
                        </section>
                        <section class="col-lg-5 sell-cart-panel" aria-labelledby="sell_cart_heading">
                            <div class="sell-panel-heading">
                                <div>
                                    <h2 id="sell_cart_heading" class="h5 mb-1">รายการสินค้า</h2>
                                    <p class="text-secondary small mb-0"><span id="cart_item_count">0</span> ชิ้นในรถเข็น</p>
                                </div>
                                <span class="sell-step-badge">2</span>
                            </div>
                            <div class="table-responsive sell-cart-table-wrap" id="cart_table_wrap" hidden>
                                <table class="table cart-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">สินค้า</th>
                                            <th scope="col">จำนวน</th>
                                            <th scope="col" class="text-end">รวม</th>
                                            <th scope="col"><span class="visually-hidden">ลบรายการ</span></th>
                                        </tr>
                                    </thead>
                                    <tbody id="cart"></tbody>
                                </table>
                            </div>
                            <div class="sell-cart-empty" id="cart_empty">
                                <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
                                <p class="mb-0">ยังไม่มีสินค้าในรถเข็น</p>
                            </div>
                            <section class="sell-order-fields mb-3" aria-labelledby="cart-assets-heading">
                                <h3 class="h6 mb-1" id="cart-assets-heading">วัสดุที่ใช้กับรายการนี้</h3>
                                <p class="small text-secondary mb-2">ระบบตัดวัสดุเมื่อยืนยันการขาย โดยไม่เพิ่มวัสดุลงในบิล</p>
                                <div id="cart_asset_list" class="small"></div>
                                <div class="input-group input-group-sm mt-2">
                                    <select id="cart_asset_select" class="form-select" aria-label="เลือกวัสดุเพิ่มเติม">
                                        <% availableCartAssets.forEach((asset, index) => { %>
                                        <option value="<%=index%>" data-type="<%=asset.asset_type%>" data-name="<%=asset.asset_name%>" data-available="<%=asset.available_count%>"><%=asset.asset_name%> (<%=asset.type%>)</option>
                                        <% }) %>
                                    </select>
                                    <button type="button" class="btn btn-outline-primary" id="add_cart_asset" <%=availableCartAssets.length ? '' : 'disabled'%>>เพิ่มวัสดุ</button>
                                </div>
                            </section>
                            <div class="sell-order-fields">
                                <div class="form-floating">
                                    <select name="customer" id="customer" class="form-select" required>
                                        <option value="-">ลูกค้าทั่วไป</option>
                                        <% customers.forEach(row => { %>
                                        <option value="<%=row.id%>"><%=row.first_name%> <%=row.last_name%></option>
                                        <% }) %>
                                    </select>
                                    <label for="customer">ลูกค้า (ไม่บังคับ)</label>
                                </div>
                                <div class="form-floating">
                                    <input type="text" class="form-control" name="discount_code" id="discount_code" value="" placeholder="โค้ดส่วนลด">
                                    <label for="discount_code">โค้ดส่วนลด</label>
                                </div>
                            </div>
                            <button type="button" class="btn btn-link text-secondary p-0 sell-clear-cart" onclick="resetCart()">
                                <i class="fa-regular fa-trash-can me-1" aria-hidden="true"></i>ล้างรายการ
                            </button>
                        </section>
                    </div>
                </div>
                <script>
                    let sellCatalogRequest;
                    let sellCatalogLoaded = false;
                    const formatCartNumber = value => new Intl.NumberFormat('en-US').format(value);

                    function initProductType(type) {
                        const catalog = document.getElementById('productSelectBox');
                        const search = document.getElementById('sell_product_search');
                        search.value = '';
                        if (sellCatalogRequest) sellCatalogRequest.abort();
                        if (!type) {
                            sellCatalogLoaded = false;
                            catalog.innerHTML = '<div class="sell-empty-state"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p class="mb-0">เลือกหมวดหมู่เพื่อดูสินค้า</p></div>';
                            return;
                        }
                        sellCatalogLoaded = false;
                        showLoadingSkeleton(catalog, 'catalog', 6);
                        sellCatalogRequest = new AbortController();
                        fetch(`/getSellProducts?type=${encodeURIComponent(type)}`, { signal: sellCatalogRequest.signal })
                            .then(async response => {
                                if (!response.ok) throw new Error('ไม่สามารถโหลดสินค้าได้');
                                return response.text();
                            })
                            .then(html => {
                                sellCatalogLoaded = true;
                                catalog.innerHTML = html;
                                catalog.removeAttribute('aria-busy');
                                filterSellProducts(search.value);
                            })
                            .catch(error => {
                                if (error.name === 'AbortError') return;
                                console.error('Error:', error);
                                showLoadingError(catalog, 'โหลดสินค้าไม่สำเร็จ กรุณาลองใหม่');
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                                });
                            });
                    }

                    function filterSellProducts(query) {
                        const normalizedQuery = query.trim().toLocaleLowerCase();
                        const items = [...document.querySelectorAll('#productSelectBox .sell-product-item')];
                        let visibleItems = 0;
                        items.forEach(item => {
                            const visible = item.dataset.search.includes(normalizedQuery);
                            item.hidden = !visible;
                            if (visible) visibleItems++;
                        });
                        let emptyState = document.querySelector('#productSelectBox .sell-search-empty');
                        if (items.length && visibleItems === 0) {
                            if (!emptyState) {
                                emptyState = document.createElement('div');
                                emptyState.className = 'sell-empty-state sell-search-empty';
                                emptyState.textContent = 'ไม่พบสินค้าที่ค้นหา';
                                document.getElementById('productSelectBox').append(emptyState);
                            }
                            emptyState.hidden = false;
                        } else if (emptyState) {
                            emptyState.hidden = true;
                        }
                    }

                    document.getElementById('sell_product_search').addEventListener('input', event => {
                        filterSellProducts(event.target.value);
                    });

                    document.getElementById('sell_modal').addEventListener('shown.bs.modal', () => {
                        const selectedType = document.getElementById('sell_product_type').value;
                        if (selectedType && !sellCatalogLoaded) initProductType(selectedType);
                    });

                    document.addEventListener('click', event => {
                        const product = event.target.closest('[data-cart-product]');
                        if (!product) return;
                        const recipe = JSON.parse(product.dataset.recipe || '[]');
                        addToCart(
                            product.dataset.type,
                            product.dataset.name,
                            product.dataset.price,
                            1,
                            product.dataset.available,
                            recipe,
                            product.dataset.trackingMode
                        );
                    });

                    document.getElementById('cart').addEventListener('click', event => {
                        const control = event.target.closest('[data-cart-action]');
                        if (!control) return;
                        const index = Number(control.dataset.index);
                        if (control.dataset.cartAction === 'increase') updateCartQuantity(index, 1);
                        if (control.dataset.cartAction === 'decrease') updateCartQuantity(index, -1);
                        if (control.dataset.cartAction === 'remove') removeCartItem(index);
                    });

                    document.getElementById('cart_asset_list').addEventListener('click', event => {
                        const control = event.target.closest('[data-cart-asset-action]');
                        if (!control) return;
                        updateCartAsset(control.dataset.assetKey, Number(control.dataset.delta));
                    });
                    document.getElementById('add_cart_asset').addEventListener('click', () => {
                        const option = document.getElementById('cart_asset_select').selectedOptions[0];
                        if (option) updateCartAsset(JSON.stringify([Number(option.dataset.type), option.dataset.name]), 1);
                    });

                    document.addEventListener('click', event => {
                        const button = event.target.closest('[data-set-tracking], [data-set-availability]');
                        if (!button) return;
                        if (button.matches('[data-set-tracking]')) {
                            setProductTrackingMode(button.dataset.type, button.dataset.name, button.dataset.mode);
                        } else {
                            setProductAvailability(button.dataset.type, button.dataset.name, button.dataset.available === 'true');
                        }
                    });

                    function showCartToast(icon, title) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon,
                            title,
                            showConfirmButton: false,
                            timer: 1800,
                            timerProgressBar: true
                        });
                    }

                    function addToCart(product_type, product_name, product_price, amount, available_count, asset_recipe = [], tracking_mode = 'quantity') {
                        product_price = Number(product_price);
                        amount = Number(amount);
                        const available = available_count === undefined
                            ? Number.MAX_SAFE_INTEGER
                            : Number(available_count);
                        if (!Number.isSafeInteger(product_price) || product_price < 0 ||
                            !Number.isSafeInteger(amount) || amount < 1 ||
                            !Number.isSafeInteger(available) || available < 0) return;
                        if (available === 0) {
                            showCartToast('info', 'สินค้าหมด');
                            return;
                        }

                        const existingIndex = cart.findIndex(item =>
                            String(item.product_type) === String(product_type) &&
                            item.product_name === product_name &&
                            Number(item.product_price) === product_price
                        );
                        if (existingIndex >= 0) {
                            const maxAvailable = Math.min(cart[existingIndex].available_count, available);
                            if (cart[existingIndex].amount + amount > maxAvailable) {
                                showCartToast('info', 'สินค้าในสต๊อกมีไม่เพียงพอ');
                                return;
                            }
                            cart[existingIndex].available_count = maxAvailable;
                            cart[existingIndex].amount += amount;
                        } else {
                            if (amount > available) {
                                showCartToast('info', 'สินค้าในสต๊อกมีไม่เพียงพอ');
                                return;
                            }
                            cart.push({
                                product_type: product_type,
                                product_name: product_name,
                                product_price: product_price,
                                amount: amount,
                                available_count: available,
                                tracking_mode,
                                asset_recipe
                            });
                        }
                        renderCart();
                        showCartToast('success', `เพิ่ม ${product_name} ลงตะกร้าแล้ว`);
                    }

                    function updateCartQuantity(index, change) {
                        const item = cart[index];
                        if (!item) return;
                        const nextAmount = item.amount + change;
                        if (nextAmount < 1) return removeCartItem(index);
                        if (nextAmount > item.available_count) {
                            showCartToast('info', 'สินค้าในสต๊อกมีไม่เพียงพอ');
                            return;
                        }
                        item.amount = nextAmount;
                        renderCart();
                    }

                    function removeCartItem(index) {
                        if (!cart[index]) return;
                        cart.splice(index, 1);
                        renderCart();
                    }

                    function getCartAssetTotals() {
                        const totalsByAsset = getBaseCartAssetTotals();
                        assetAdjustments.forEach((adjustment, key) => {
                            const current = totalsByAsset.get(key) || {
                                assetType: adjustment.assetType,
                                assetName: adjustment.assetName,
                                amount: 0
                            };
                            current.amount += adjustment.delta;
                            totalsByAsset.set(key, current);
                        });
                        return [...totalsByAsset.entries()]
                            .filter(([, value]) => value.amount > 0)
                            .map(([key, value]) => ({ ...value, key }));
                    }

                    function getBaseCartAssetTotals() {
                        const totalsByAsset = new Map();
                        cart.forEach(item => item.asset_recipe.forEach(recipe => {
                            const assetType = Number(recipe.asset_type);
                            const assetName = recipe.asset_name;
                            const key = JSON.stringify([assetType, assetName]);
                            const current = totalsByAsset.get(key) || { assetType, assetName, amount: 0 };
                            current.amount += Number(recipe.amount_per_product) * item.amount;
                            totalsByAsset.set(key, current);
                        }));
                        return totalsByAsset;
                    }

                    function normalizeAssetAdjustments() {
                        const baseTotals = getBaseCartAssetTotals();
                        assetAdjustments.forEach((adjustment, key) => {
                            const baseAmount = baseTotals.get(key)?.amount || 0;
                            if (adjustment.delta < -baseAmount) adjustment.delta = -baseAmount;
                            if (!baseAmount && adjustment.delta < 0) assetAdjustments.delete(key);
                            else if (!adjustment.delta) assetAdjustments.delete(key);
                        });
                    }

                    function updateCartAsset(key, delta) {
                        const current = assetAdjustments.get(key);
                        const [assetType, assetName] = JSON.parse(key);
                        const currentTotal = getCartAssetTotals().find(asset => asset.key === key)?.amount || 0;
                        if (currentTotal + delta < 0) return;
                        if (delta > 0) {
                            const option = [...document.querySelectorAll('#cart_asset_select option')]
                                .find(item => Number(item.dataset.type) === assetType && item.dataset.name === assetName);
                            if (option && currentTotal + delta > Number(option.dataset.available)) {
                                showCartToast('info', `วัสดุ ${assetName} มีไม่เพียงพอ`);
                                return;
                            }
                        }
                        const adjustment = current || { assetType, assetName, delta: 0 };
                        adjustment.delta += delta;
                        if (!adjustment.delta) assetAdjustments.delete(key);
                        else assetAdjustments.set(key, adjustment);
                        renderCartAssets();
                    }

                    function renderCartAssets() {
                        const container = document.getElementById('cart_asset_list');
                        container.replaceChildren();
                        const rows = getCartAssetTotals();
                        if (!rows.length) {
                            container.textContent = 'วัสดุจะปรากฏที่นี่เมื่อกำหนดสูตรสินค้า หรือเลือกวัสดุเพิ่ม';
                            return;
                        }
                        rows.forEach(asset => {
                            const row = document.createElement('div');
                            row.className = 'd-flex align-items-center justify-content-between gap-2 border-bottom py-1';
                            const label = document.createElement('span');
                            label.textContent = `${asset.assetName} × ${asset.amount}`;
                            const controls = document.createElement('span');
                            controls.className = 'd-flex gap-1';
                            [-1, 1].forEach(delta => {
                                const button = document.createElement('button');
                                button.type = 'button';
                                button.className = 'btn btn-sm btn-outline-secondary';
                                button.dataset.cartAssetAction = 'adjust';
                                button.dataset.assetKey = asset.key;
                                button.dataset.delta = delta;
                                button.setAttribute('aria-label', delta > 0 ? `เพิ่ม ${asset.assetName}` : `ลด ${asset.assetName}`);
                                button.textContent = delta > 0 ? '+' : '−';
                                controls.append(button);
                            });
                            row.append(label, controls);
                            container.append(row);
                        });
                    }

                    function setProductTrackingMode(type, name, tracking_mode) {
                        Swal.fire({
                            icon: 'question',
                            title: tracking_mode === 'availability' ? 'เปลี่ยนเป็นสต๊อกแบบมี/หมด?' : 'เปลี่ยนเป็นสต๊อกแบบจำนวน?',
                            text: name,
                            showCancelButton: true,
                            confirmButtonText: 'ยืนยัน',
                            cancelButtonText: 'ยกเลิก'
                        }).then(result => {
                            if (!result.isConfirmed) return;
                            fetch('/productInventorySettings', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ type, name, tracking_mode })
                            }).then(async response => {
                                const data = await response.json();
                                if (!response.ok) throw new Error(data.error || 'เปลี่ยนรูปแบบสต๊อกไม่สำเร็จ');
                            }).then(() => searchByType(_type))
                                .catch(error => Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: error.message }));
                        });
                    }

                    function setProductAvailability(type, name, available) {
                        fetch('/productAvailability', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ type, name, available })
                        }).then(async response => {
                            const data = await response.json();
                            if (!response.ok) throw new Error(data.error || 'เปลี่ยนสถานะสินค้าไม่สำเร็จ');
                        }).then(() => searchByType(_type))
                            .catch(error => Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: error.message }));
                    }

                    function renderCart() {
                        normalizeAssetAdjustments();
                        const table = document.getElementById('cart');
                        const emptyState = document.getElementById('cart_empty');
                        table.replaceChildren();
                        emptyState.hidden = cart.length > 0;
                        document.getElementById('cart_table_wrap').hidden = cart.length === 0;
                        if (cart.length) {
                            cart.forEach((item, index) => {
                                const row = table.insertRow();
                                const productCell = row.insertCell();
                                productCell.className = 'sell-cart-product';
                                productCell.textContent = item.product_name;

                                const quantityCell = row.insertCell();
                                quantityCell.append(
                                    createCartControl('decrease', index, 'ลดจำนวน'),
                                    Object.assign(document.createElement('span'), {
                                        className: 'sell-cart-quantity',
                                        textContent: item.amount
                                    }),
                                    createCartControl('increase', index, 'เพิ่มจำนวน')
                                );

                                const totalCell = row.insertCell();
                                totalCell.className = 'text-end text-nowrap';
                                totalCell.textContent = formatCartNumber(item.product_price * item.amount);

                                const removeCell = row.insertCell();
                                removeCell.append(createCartControl('remove', index, 'นำสินค้าออก'));
                            });
                        }
                        renderCartAssets();
                        totals = cart.reduce((sum, item) => sum + item.product_price * item.amount, 0);
                        document.getElementById('cart_item_count').textContent = cart.reduce((sum, item) => sum + item.amount, 0);
                        initTotal();
                    }

                    function createCartControl(action, index, label) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = `btn btn-sm sell-cart-control${action === 'remove' ? ' sell-cart-remove' : ''}`;
                        button.dataset.cartAction = action;
                        button.dataset.index = index;
                        button.setAttribute('aria-label', label);
                        const icon = document.createElement('i');
                        icon.className = action === 'increase' ? 'fa-solid fa-plus' :
                            action === 'decrease' ? 'fa-solid fa-minus' : 'fa-solid fa-trash-can';
                        icon.setAttribute('aria-hidden', 'true');
                        button.append(icon);
                        return button;
                    }

                    function initTotal() {
                        const totalElement = document.getElementById('totals_text');
                        if (totalElement) totalElement.textContent = formatCartNumber(totals);
                    }
                    function resetCart() {
                        cart = []
                        assetAdjustments = new Map()
                        totals = 0
                        initTotal()
                        renderCart()
                        document.getElementById('sell_product_search').value = ''
                        document.getElementById('discount_code').value = ''
                        filterSellProducts('')
                    }
                    function sellProducts() {
                        let customer = document.getElementById('customer').value
                        let discount_code = document.getElementById('discount_code').value || null

                        const options = {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            cart: cart.map(({ product_type, product_name, product_price, amount }) => ({
                                product_type,
                                product_name,
                                product_price,
                                amount
                            })),
                            customer:customer,
                            discount_code:discount_code,
                            asset_adjustments: [...assetAdjustments.values()].map(({ assetType, assetName, delta }) => ({
                                asset_type: assetType,
                                asset_name: assetName,
                                delta
                            }))
                        })
                        };

                        if(!customer || cart.length == 0) {
                            Swal.fire({
                                icon: 'error',
                                title: 'โปรดกรอกข้อมูลการขายสินค้าให้ครบถ้วน'
                            });
                            return;
                        }

                        fetch('/sellProduct', options)
                        .then(res => {
                            if (!res.ok) {
                                return res.json().then(errorData => { throw new Error(errorData.error); });
                            }
                            return res.json();
                        })
                        .then(data => {
                            Swal.fire({
                                icon: 'success',
                                title: 'เพิ่มข้อมูลการขายแล้ว!',
                            }).then(() => {
                                openLink(data.bill)
                            });
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: error.message || 'โปรดลองอีกครั้งในภายหลัง',
                            });
                        });  
                    }

                    function createQuotation() {
                        const customer = document.getElementById('customer').value;
                        const discountCode = document.getElementById('discount_code').value || null;
                        if (!customer || cart.length === 0) {
                            showCartToast('info', 'เพิ่มสินค้าในรถเข็นก่อนออกใบเสนอราคา');
                            return;
                        }

                        fetch('/quotations', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                cart: cart.map(({ product_type, product_name, product_price, amount }) => ({
                                    product_type,
                                    product_name,
                                    product_price,
                                    amount
                                })),
                                customer,
                                discount_code: discountCode,
                                asset_adjustments: [...assetAdjustments.values()].map(({ assetType, assetName, delta }) => ({
                                    asset_type: assetType,
                                    asset_name: assetName,
                                    delta
                                }))
                            })
                        })
                        .then(async response => {
                            const data = await response.json();
                            if (!response.ok) throw new Error(data.error || 'ออกใบเสนอราคาไม่สำเร็จ');
                            return data;
                        })
                        .then(data => {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: 'ออกใบเสนอราคาแล้ว (ยังไม่ตัดสต๊อก)',
                                showConfirmButton: false,
                                timer: 1800
                            }).then(() => openLink(data.quotation));
                        })
                        .catch(error => {
                            console.error('Quotation creation failed:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'ออกใบเสนอราคาไม่สำเร็จ',
                                text: error.message || 'โปรดลองอีกครั้งในภายหลัง'
                            });
                        });
                    }

                    document.addEventListener('DOMContentLoaded', initTotal, { once: true });
                </script>
                <div class="modal-footer sell-modal-footer">
                  <div class="sell-total">
                    <span class="text-secondary small">ยอดที่ต้องชำระ</span>
                    <strong><span id="totals_text"></span> <span class="small fw-normal">บาท</span></strong>
                  </div>
                  <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="resetCart()">ยกเลิก</button>
                    <button type="button" class="btn btn-outline-primary" onclick="createQuotation()"><i class="fa-solid fa-file-invoice me-1"></i> ออกใบเสนอราคา</button>
                    <button type="button" class="btn btn-primary" onclick="sellProducts()"><i class="fa-solid fa-circle-check me-1"></i> ยืนยันการขาย</button>
                  </div>
                </div>
              </div>
            </div>
        </div>
        <% } %>
        <%-include('include/footer')%>
    </body>
</html>
