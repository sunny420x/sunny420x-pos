<!doctype html>
<html lang="th">
<head>
    <title>ใบเสนอราคา | OpenPOS</title>
    <%-include('include/head')%>
</head>
<body>
    <% const helper = new Helper(); %>
    <div class="d-flex app-shell">
        <%-include('include/sidebar')%>
        <main class="container-fluid p-0 app-main">
            <%-include('include/navigator')%>
            <div class="container-fluid p-4 app-content">
                <section class="card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h1 class="h3 mb-1"><i class="fa-solid fa-file-invoice me-1" aria-hidden="true"></i> ใบเสนอราคา</h1>
                            <p class="text-secondary mb-0">รายการใบเสนอราคาที่ออกไว้ทั้งหมด</p>
                        </div>
                        <a class="btn btn-outline-secondary" href="/products_stock">
                            <i class="fa-solid fa-cart-shopping me-1" aria-hidden="true"></i> กลับไปสินค้า
                        </a>
                    </div>
                    <% if (quotations.length) { %>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>เลขที่</th>
                                    <th>วันที่</th>
                                    <th>ลูกค้า</th>
                                    <th class="text-end">ยอดรวม</th>
                                    <th>สถานะ</th>
                                    <th class="text-end">เอกสาร</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% quotations.forEach(quotation => { %>
                                <tr>
                                    <td class="fw-semibold">QT-<%=quotation.id%></td>
                                    <td><%=moment(quotation.created_at).add(543, 'years').format('DD/MM/YYYY HH:mm')%></td>
                                    <td><%=quotation.first_name && quotation.last_name ? `${quotation.first_name} ${quotation.last_name}` : 'ลูกค้าทั่วไป'%></td>
                                    <td class="text-end"><%=helper.numberWithCommas(quotation.total)%> บาท</td>
                                    <td>
                                        <% if (quotation.status === 'confirmed') { %>
                                        <span class="badge text-bg-success">ยืนยันการขายแล้ว</span>
                                        <% } else { %>
                                        <span class="badge text-bg-warning">รอยืนยันการขาย</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-primary" href="/quotations/<%=quotation.id%>" aria-label="เปิดใบเสนอราคา QT-<%=quotation.id%>">
                                            <i class="fa-solid fa-folder-open me-1" aria-hidden="true"></i> เปิด
                                        </a>
                                        <% if (quotation.billing_id) { %>
                                        <a class="btn btn-sm btn-outline-secondary" href="/billing/<%=quotation.billing_id%>" aria-label="เปิดใบเสร็จ #<%=quotation.billing_id%>">
                                            <i class="fa-solid fa-receipt me-1" aria-hidden="true"></i> ใบเสร็จ
                                        </a>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center text-secondary py-5">
                        <i class="fa-regular fa-file-lines fs-2 mb-2" aria-hidden="true"></i>
                        <p class="mb-0">ยังไม่มีใบเสนอราคา</p>
                    </div>
                    <% } %>
                    <%-include('Components/pagination', { pagination: pagination })%>
                </section>
            </div>
        </main>
    </div>
    <%-include('include/footer')%>
</body>
</html>
