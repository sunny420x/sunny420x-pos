<!doctype html><html lang="th"><head><meta charset="utf-8"><title>สมัครบริษัท | SunnyPOS</title><%- include('include/head') %></head><body><main class="container py-5" style="max-width:520px"><div class="card"><div class="card-body p-4"><h1 class="h3">SunnyPOS</h1><h2 class="h5 mb-4">สมัครบริษัท</h2><% if(error) { %><p class="alert alert-danger"><%= error %></p><% } %><form method="post" action="/register"><div class="mb-3"><label for="company_name" class="form-label">ชื่อบริษัท</label><input id="company_name" name="company_name" type="text" class="form-control" required maxlength="100" ></div><div class="mb-3"><label for="company_code" class="form-label">รหัสบริษัท</label><input id="company_code" name="company_code" type="text" class="form-control" required maxlength="100" ></div><div class="mb-3"><label for="full_name" class="form-label">ชื่อผู้ดูแล</label><input id="full_name" name="full_name" type="text" class="form-control" required maxlength="100" ></div><div class="mb-3"><label for="username" class="form-label">ชื่อผู้ใช้</label><input id="username" name="username" type="text" class="form-control" required maxlength="100" ></div><div class="mb-3"><label for="password" class="form-label">รหัสผ่าน (อย่างน้อย 8 ตัวอักษร)</label><input id="password" name="password" type="password" class="form-control" required maxlength="128" minlength="8"></div><button class="btn btn-primary w-100">สมัครบริษัท</button></form><p class="mt-3 mb-0"><a href="/login">เข้าสู่ระบบ</a></p></div></div></main></body></html>