<html>
    <head>
        <title>ตั้งค่า | OpenPOS</title>
        <%-include('include/head')%>
    </head>
    <body>
        <div class="d-flex app-shell">
            <%-include('include/sidebar')%>
            <div class="container-fluid p-0 overflow-hidden app-main">
                <%-include('include/navigator')%>
                <div class="container-fluid p-4 app-content">
                    <div class="card p-4">
                        <div class="row grid-2 g-0 gap-3">
                            <div class="col-lg-auto">
                                <div class="rounded mx-auto" id="profileCircleSetting">
                                    <script>
                                        document.getElementById('profileCircleSetting').setAttribute("style", "width: 80px; height: 80px; background: <%=user_data[0].color%>;")
                                    </script>
                                    <div style="text-align: center; margin: auto; display: block; padding: 20px; font-size: 28px; text-transform: capitalize;"><%=user_data[0].username[0]%></div>
                                </div>
                            </div>
                            <div class="col-lg">
                                <h4><%=user_data[0].full_name%> <span class="badge bg-secondary"><%=user_data[0].type%></span></h4>
                                <p>กำลังเข้าสู่ระบบด้วยชื่อผู้ใช้: <%=user_data[0].username%></p>
                            </div>
                        </div>
                    </div>
                    <% if (user_data[0].permission.split(',').includes('users')) { %>
                    <div class="card my-4 p-4">
                        <h3><i class="fa-solid fa-cogs me-2"></i> โหมดการทำงานของระบบ</h3>
                        <p>การตั้งค่านี้มีผลกับผู้ใช้ทุกคนในบริษัท</p>
                        <form action="/settings/stock-mode" method="post" class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label for="stock_mode" class="form-label">เลือกรูปแบบการทำงาน</label>
                                <select class="form-select" name="stock_mode" id="stock_mode" required>
                                    <option value="pos" <%=user_data[0].stock_mode !== 'inventory_only' ? 'selected' : ''%>>ตัดสต๊อก + ขายหน้าร้าน</option>
                                    <option value="inventory_only" <%=user_data[0].stock_mode === 'inventory_only' ? 'selected' : ''%>>จัดการสต๊อกอย่างเดียว</option>
                                </select>
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> บันทึกโหมด</button>
                            </div>
                        </form>
                    </div>
                    <div class="card my-4 p-4">
                        <h3><i class="fa-solid fa-receipt me-2"></i> ขนาดใบเสร็จ</h3>
                        <p>การตั้งค่านี้มีผลกับใบเสร็จของผู้ใช้ทุกคนในบริษัท</p>
                        <form action="/settings/receipt-size" method="post" class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label for="receipt_size" class="form-label">เลือกรูปแบบใบเสร็จ</label>
                                <select class="form-select" name="receipt_size" id="receipt_size" required>
                                    <option value="80x80" <%=user_data[0].receipt_size === '80x80' ? 'selected' : ''%>>80 × 80 มม.</option>
                                    <option value="a5_landscape" <%=user_data[0].receipt_size !== '80x80' ? 'selected' : ''%>>A5 แนวนอน</option>
                                </select>
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> บันทึกขนาดใบเสร็จ</button>
                            </div>
                        </form>
                    </div>
                    <% } %>
                    <div class="row card my-4 p-4 g-0">
                        <h3><i class="fa-solid fa-cog m-4 mx-2 mt-2"></i> ข้อมูลในระบบ</h3>
                        <div class="col">
                            <div class="list-group">
                                <%if(user_data[0].permission.split(',').includes('customers')) {%>
                                    <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/product_types')">
                                        <i class="fa-solid fa-boxes me-1"></i> ประเภทของสินค้า</button>
                                <%}%>
                                <%if(user_data[0].permission.split(',').includes('users')) {%>
                                    <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/user_types')">
                                        <i class="fa-solid fa-users-cog me-1"></i> ประเภทของผู้ใช้</button>
                                <%}%>
                            </div>
                        </div>
                    </div>
                    <div class="row gap-4 g-0 mt-4">
                        <%if(user_data[0].permission.split(',').includes('users')) {%>
                        <div class="card col p-4">
                            <h3><i class="fa-solid fa-users mx-1"></i> ผู้ใช้</h3>
                            <div class="list-group mt-3">
                                <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/Users')">
                                    <i class="fa-solid fa-users-cog me-1"></i> จัดการผู้ใช้</button>
                                <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/addUser')">
                                    <i class="fa-solid fa-user-plus me-1"></i> เพิ่มผู้ใช้</button>
                                <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/loginHistories')">
                                    <i class="fa-solid fa-user-clock me-1"></i> ประวัติการเข้าสู่ระบบของผู้ใช้</button>
                            </div>
                        </div>
                        <%}%>
                        <div class="card col p-4">
                            <h3><i class="fa-solid fa-user mx-1"></i> บัญชี</h3>
                            <div class="list-group mt-3">
                                <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/editProfile')">
                                    <i class="fa-solid fa-user-cog me-1"></i> แก้ไขข้อมูลส่วนตัว</button>
                                <button type="button" class="list-group-item list-group-item-action" onclick="openLink('/changePassword')">
                                    <i class="fa-solid fa-user-lock me-1"></i> เปลี่ยนรหัสผ่าน</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%-include('include/footer')%>
    </body>
</html>
